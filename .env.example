# ============ 存储后端 ============
# postgres（默认，正式后端）| sqlite（回滚兜底，勿用于新部署）
#
# 迁移已完成。不配这一项就是 postgres —— 默认值必须和事实一致，
# 否则漏配一次就悄悄跑在一个已经退场的存储实现上。
DB_BACKEND=postgres
# PostgreSQL 连接串。**建库时务必带 LC_COLLATE=C LC_CTYPE=C**：
# PG 的默认排序规则和 SQLite 的 BINARY 不同，会让分页/搜索/导出顺序对不上。
# 理由见 docs/local_macos_setup.md §1
PG_DSN=postgresql://scraper@127.0.0.1:5432/scraper

# ============ 服务 ============
SERVER_PORT=8899

# 部署标识。不配则两个克隆部署在事件流里无法区分。
SCRAPER_INSTANCE_ID=

# ============ 采集 ============
# 代理地址（TPS 模式，每次请求自动换 IP）
PROXY_URL=http://user:pwd@host:port

# 配送邮编
DEFAULT_ZIP_CODE=10001

# ============ catalog_sync 增量导出 ============
# X-Export-Token 请求头的共享密钥。
# 契约里鉴权是**可选**的：不配就放行（每次打 WARNING），配了就强制校验。
# 服务器是公网 IP —— 上公网前请配上。
EXPORT_TOKEN=
# 设为 1 则「没配 EXPORT_TOKEN 就直接关闭该端点（503）」，而不是放行。
EXPORT_REQUIRE_TOKEN=

# ============ 破坏性操作鉴权 ============
# 保护这几类操作：DELETE /api/database（清空全库 + 全部截图）、删批次、
# 批量删批次、删结果、恢复默认设置、worker 删除/重启。
#
# 与 EXPORT_TOKEN 同样是**可选**的：不配就放行（首次命中打一条 WARNING），
# 配了就强制校验。不配时，上面这些操作是任何人发一个 HTTP 请求就能触发的 ——
# 服务若能从不受信网络访问，请务必配上。
#
# 传令牌：X-Admin-Token 请求头，或同源 cookie admin_token
#（控制台「设置」页有输入框，填一次即可，之后网页操作自动带上）。
ADMIN_TOKEN=
